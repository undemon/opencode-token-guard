{
  "$schema": "https://opencode.ai/config.json",

  // Example plugin registration. Replace the path with the absolute path to this directory.
  "plugins": [
    {
      "package": "/path/to/opencode-token-guard",
      "options": {
        // LM Studio backend base URL (no /v1, no trailing slash).
        "backend": "http://127.0.0.1:1234",

        // OpenCode providers the hooks and the limit sync apply to.
        // An empty list = all providers.
        "providerIDs": ["my-provider"],

        // "local" — count with a local tokenizer.json (recommended for LM Studio).
        "mode": "local",

        // Path to tokenizer.json from the model folder (next to the GGUF).
        // Windows: C:/Users/<user>/.lmstudio/models/<publisher>/<repo>/tokenizer.json
        "tokenizerPath": "C:/Users/<user>/.lmstudio/models/<publisher>/<repo>/tokenizer.json",

        // Optional:
        // "tokenizerConfigPath": ".../tokenizer_config.json",

        // Sync model.limit.context with the engine's actual window.
        "syncLimit": true,
        "syncLimitDownOnly": false,

        // Upper bound for the window: caps limit.context and the request budget (optional).
        // "maxContext": 104000,

        // Budget = W − reservedOutputTokens − safetyMarginPct% of W, where W = min(window, maxContext).
        "reservedOutputTokens": 8192,
        "safetyMarginPct": 8,

        "includeToolsInBudget": true,

        // Share of the request budget used as the cap for a condensed checkpoint digest.
        "digestShare": 0.3,

        // Per-entry token limits used while condensing.
        "condense": {
          "userTokens": 400,
          "assistantTokens": 300,
          "reasoningTailTokens": 500,
          "reasoningKeep": 1,
          "toolCallTokens": 120,
          "toolResultTokens": 300,
          "toolErrorTokens": 600,
          "miscTokens": 200,
          "ledgerKeep": 2
        },

        "debug": false

        // File to duplicate logs to, when console is unavailable (optional).
        // "logFile": "/tmp/opencode/token-guard.log"
      }
    }
  ]
}
